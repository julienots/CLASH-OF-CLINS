{
  "name": "kingdoms",
  "version": "1.0.0",
  "private": true,
  "description": "KINGDOMS — jeu de stratégie de villages (client HTML5/TypeScript + wrapper Android + serveur autoritaire)",
  "type": "module",
  "scripts": {
    "build": "node tools/build-web.mjs",
    "dev": "node tools/build-web.mjs --serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:long": "vitest run --config vitest.long.config.ts",
    "test:e2e": "node tools/e2e.mjs",
    "server": "node tools/run-server.mjs",
    "android": "node tools/build-web.mjs && bash android/build.sh",
    "test:all": "npm run typecheck && npm test && npm run test:long && npm run build && npm run test:e2e",
    "icons": "node tools/gen-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
